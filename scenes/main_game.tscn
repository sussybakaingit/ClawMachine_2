text = "QUICK START: HOW TO PLAY"
horizontal_alignment = 1

[node name="Body" type="Label" parent="UIManager/TutorialDialog/VBox"]
layout_mode = 2
text = "1. WEBCAM HAND CONTROLS:
• Move your hand Left/Right/Up/Down in front of webcam to guide the claw.
• PINCH (thumb + index) to lower claw and grab a toy!
• MANUALLY MOVE claw over the delivery hole (front-left chute)!
• PINCH or release hand to drop the toy into the chute to score!

2. KEYBOARD CONTROLS:
• Move Claw: WASD or Arrow Keys
• Grab Toy: Spacebar or Enter
• Release Toy: R or Spacebar
• Camera Orbit: Right-Click + Drag
• Camera Zoom: Scroll Wheel (or use presets at top)"
autowrap_mode = 3

