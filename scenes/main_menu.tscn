[node name="Body" type="Label" parent="TutorialDialog/VBox"]
layout_mode = 2
text = "1. WEBCAM HAND CONTROLS:
• Move your hand Left/Right & Up/Down in front of camera to position the claw.
• PINCH (thumb + index) to drop the claw and grab a toy!
• After grabbing, MANUALLY navigate the claw to the delivery chute (front-left)!
• PINCH or open hand to release the toy into the chute to score!

2. KEYBOARD FALLBACK:
• Move: WASD or Arrow Keys
• Grab: Spacebar or Enter
• Release: R or Spacebar
• Camera: Right-Click + Drag, Scroll Wheel to Zoom
• Presets: C to reset camera"
autowrap_mode = 3

